# =============================================================================
# Backend Environment Configuration
# Semantic Media Engine - FastAPI Backend
# =============================================================================
# Copy this file to .env and update values for your environment
# All variables are required unless marked as optional

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
# PostgreSQL is used to store structured media metadata (title, description, etc.)

# Database host (default: localhost for local development)
POSTGRES_HOST=localhost

# Database port (default: 5432)
POSTGRES_PORT=5432

# Database name (must be created before running the application)
POSTGRES_DB=semantic_media

# Database user with read/write permissions
POSTGRES_USER=postgres

# Database password (CHANGE THIS in production!)
POSTGRES_PASSWORD=your_password_here

# =============================================================================
# Vector Database Configuration
# =============================================================================
# Choose between file-based storage (no external dependencies) or Qdrant

# Use file-based vector storage (true) or Qdrant (false)
# File-based storage: Embeddings stored in local files (no Docker/Qdrant needed)
# Qdrant: External vector database (requires Docker or Qdrant installation)
USE_FILE_STORAGE=true

# Qdrant Configuration (only needed if USE_FILE_STORAGE=false)
# Install Qdrant: docker run -p 6333:6333 qdrant/qdrant

# Qdrant server host (default: localhost for local development)
QDRANT_HOST=localhost

# Qdrant server port (default: 6333)
QDRANT_PORT=6333

# Collection name for storing media embeddings
# This collection will be created automatically if it doesn't exist
QDRANT_COLLECTION_NAME=media_embeddings

# Vector dimensionality - MUST match the vectorizer type:
# - TF-IDF: 5000 dimensions (default for TF-IDF vectorizer)
# - Sentence-BERT: 384 dimensions (all-MiniLM-L6-v2 model)
# IMPORTANT: This must match VECTORIZER_TYPE setting
VECTOR_SIZE=384

# =============================================================================
# Vectorizer Configuration (Sentence-BERT Upgrade)
# =============================================================================

# Vectorizer type: "tfidf" or "sbert" (Sentence-BERT)
# - tfidf: Traditional TF-IDF sparse vectors (~5000 dimensions)
# - sbert: Sentence-BERT dense embeddings (384 dimensions)
# Default: sbert (recommended for semantic search)
VECTORIZER_TYPE=sbert

# Sentence-BERT model name (only used when VECTORIZER_TYPE=sbert)
# Default: all-MiniLM-L6-v2 (384 dimensions, fast and accurate)
# Other options: all-mpnet-base-v2 (768 dims, more accurate but slower)
SBERT_MODEL_NAME=all-MiniLM-L6-v2

# =============================================================================
# API Server Configuration
# =============================================================================

# CORS Origins - Comma-separated list of allowed origins for cross-origin requests
# Include all URLs where your frontend will be hosted
# For local development, include both localhost and 127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API server host (0.0.0.0 allows external connections, 127.0.0.1 for localhost only)
API_HOST=0.0.0.0

# API server port (default: 8000)
API_PORT=8000

# =============================================================================
# Machine Learning Model Configuration
# =============================================================================

# Path to the directory containing vectorizer models
# This directory stores both TF-IDF and Sentence-BERT model configurations
# Can be absolute or relative to the backend directory
VECTORIZER_PATH=backend/models

# Path to the directory containing pre-computed embeddings
# Used for storing and loading vector embeddings
EMBEDDINGS_PATH=backend/embeddings

# Model version identifier for tracking which vectorizer generated embeddings
# Update this when retraining the vectorizer to track model versions
MODEL_VERSION=v1.0.0

# =============================================================================
# Setup Instructions
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Update POSTGRES_PASSWORD with a secure password
# 3. Ensure PostgreSQL is running and database exists:
#    createdb semantic_media
# 4. Run database migrations:
#    python backend/database/migrate.py
# 5. Choose vectorizer type:
#    - For Sentence-BERT (recommended): Set VECTORIZER_TYPE=sbert, VECTOR_SIZE=384
#    - For TF-IDF: Set VECTORIZER_TYPE=tfidf, VECTOR_SIZE=5000
# 6. Process dataset to generate embeddings:
#    python backend/data_pipeline/example_usage.py
# 7. (Optional) Migrate from TF-IDF to Sentence-BERT:
#    python backend/data_pipeline/migrate_to_sbert.py
# 8. Start the backend server:
#    cd backend && uvicorn main:app --reload
#
# For production deployment:
# - Use strong passwords and secure connection strings
# - Consider using environment-specific .env files (.env.production)
# - Enable SSL/TLS for database connections
# - Use a reverse proxy (nginx) in front of the API server
# - Set API_HOST=127.0.0.1 if using a reverse proxy
# =============================================================================

# =============================================================================
# Hybrid Search Configuration
# =============================================================================
# Enable hybrid search combining TF-IDF (keyword matching) and Sentence-BERT (semantic)
# This provides better results for both exact title matches and semantic queries
USE_HYBRID_SEARCH=true

# =============================================================================
# TMDB API Configuration
# =============================================================================
# The Movie Database (TMDB) API for fetching movie/TV show posters
# Get your free API key from: https://www.themoviedb.org/settings/api
# Leave empty to disable poster fetching
TMDB_API_KEY=your_tmdb_api_key_here
