# =============================================================================
# Frontend Environment Configuration
# Semantic Media Engine - Next.js Frontend
# =============================================================================
# Copy this file to .env.local and update values for your environment
# Note: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser

# =============================================================================
# Backend API Configuration
# =============================================================================

# Backend API base URL
# This is the URL where the FastAPI backend is running
# IMPORTANT: Must be prefixed with NEXT_PUBLIC_ to be accessible in browser code
#
# Local Development:
#   - Use http://localhost:8000 when backend runs on default port
#   - Use http://127.0.0.1:8000 as alternative
#
# Production:
#   - Use your production API domain (e.g., https://api.yourdomain.com)
#   - Ensure HTTPS is enabled for security
#   - Update CORS_ORIGINS in backend .env to include your frontend domain
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# Optional Configuration
# =============================================================================

# API request timeout in milliseconds (optional, default: 10000)
# Uncomment to override the default timeout
# NEXT_PUBLIC_API_TIMEOUT=10000

# Enable debug mode for API client (optional, default: false)
# Uncomment to enable verbose logging in browser console
# NEXT_PUBLIC_DEBUG=false

# =============================================================================
# Setup Instructions
# =============================================================================
# 1. Copy this file: cp .env.local.example .env.local
# 2. Update NEXT_PUBLIC_API_URL to match your backend URL
# 3. Ensure the backend is running and accessible
# 4. Install dependencies: npm install
# 5. Start the development server: npm run dev
# 6. Open http://localhost:3000 in your browser
#
# For production deployment:
# - Update NEXT_PUBLIC_API_URL to your production API URL
# - Ensure backend CORS_ORIGINS includes your frontend domain
# - Build the application: npm run build
# - Start production server: npm start
# - Or deploy to Vercel/Netlify/other hosting platforms
#
# Troubleshooting:
# - If you see CORS errors, verify CORS_ORIGINS in backend .env
# - If API requests fail, check that backend is running on the specified URL
# - Use browser DevTools Network tab to inspect API requests
# =============================================================================
