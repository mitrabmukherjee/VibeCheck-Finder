            print(f"✓ New embedding dimension: 768")
            print(f"✓ Duration: {report['duration_seconds']:.1f} seconds")
            print("\nRestart your backend to use the new model:")
            print("  cd backend")
            print("  python -m uvicorn main:app --reload --host 127.0.0.1 --port 8000")
